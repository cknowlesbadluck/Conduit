# Public Conduit origin. Required for production host/origin validation.
PUBLIC_URL=https://conduit-feco.onrender.com

# Durable PostgreSQL. Leave unset for in-memory development storage.
DATABASE_URL=
DATABASE_SSL=true

# OAuth/OIDC via Descope. Set this to the .well-known OpenID configuration URL
# shown by the Descope MCP Server configuration.
DESCOPE_MCP_SERVER_WELL_KNOWN_URL=
DESCOPE_MCP_SERVER_ISSUER=
MCP_RESOURCE_URL=https://conduit-feco.onrender.com/mcp

# OAuth scopes. Configure the same scopes on the Descope MCP Server.
CONDUIT_READ_SCOPE=mcp:conduit.read
CONDUIT_WRITE_SCOPE=mcp:conduit.write

# Optional comma-separated browser origins for CORS reflection.
# Leave empty to allow any origin (bearer tokens only; no cookies).
# Example: https://chatgpt.com,https://claude.ai,https://grok.com
MCP_ALLOWED_ORIGINS=

# Private development fallback. Never use this instead of OAuth for production.
CONDUIT_TOKEN=
CONDUIT_ALLOW_ANONYMOUS=false

MAX_JSON_BODY=1mb
